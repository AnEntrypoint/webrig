{
  "name": "webrig",
  "version": "1.0.43",
  "description": "General-purpose Electron browser with audio routing to Discord",
  "main": "src/main.js",
  "type": "module",
  "exports": {
    "./companion": "./companion/index.js",
    "./bot": "./src/bot/client.js",
    "./voice": "./src/bot/voice.js",
    "./swarm": "./src/p2p/swarm.js",
    "./client": "./src/p2p/client.js",
    "./cdp-client": "./cdp-client.js",
    "./agent": "./agent.js",
    "./bridge": "./companion/bridge.js",
    "./cdp-client-inpage": "./cdp-client-inpage.js",
    "./bridge-sw": "./bridge-sw.js"
  },
  "files": [
    "src/bot",
    "src/p2p",
    "companion/index.js",
    "companion/bridge.js",
    "companion/acp.js",
    "companion/rpc.js",
    "src/electron/capture-worklet.js",
    "bin/",
    "shell/",
    "agent.js",
    "bridge-sw.js",
    "cdp-client.js",
    "cdp-client-inpage.js",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "build": "electron-builder --win",
    "headless": "node src/p2p/client.js",
    "companion": "node companion/index.js",
    "bridge": "node companion/bridge.js",
    "bridge:companion": "node companion/index.js & node companion/bridge.js",
    "webrig": "node bin/webrig.js",
    "rpc": "node companion/rpc.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.11",
    "b4a": "^1.8.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "hyperswarm": "^4.17.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.webrig.app",
    "productName": "Webrig",
    "forceCodeSigning": false,
    "asar": true,
    "extraResources": [
      {
        "from": "src/electron/capture-worklet.js",
        "to": "capture-worklet.js"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "AnEntrypoint",
      "repo": "webrig"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!.env",
      "!**/*.md",
      "!logs.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "bin": {
    "webrig": "./bin/webrig.js"
  }
}
