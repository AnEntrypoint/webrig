{
  "manifest_version": 2,
  "name": "Webrig Audio Bridge",
  "version": "1.0.0",
  "description": "Full host mode: tab audio/video relay, CDP passthrough, and input forwarding to Webrig via WebSocket",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "audio-pipeline.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Webrig Audio Bridge"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  }
}
